{
  "name": "boloncity-tienda-backapp",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "compile": "tsc --watch",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "ts-node-dev --transpile-only src/seeds/seed.ts",
    "seed:menu": "ts-node-dev --transpile-only src/seeds/seedMenu.ts",
"seed:branches": "ts-node-dev --transpile-only src/seeds/seedBranches.ts",
    "test:precheckout": "ts-node-dev --transpile-only src/scripts/testPreCheckout.ts",
    "picker:sync": "ts-node --transpile-only src/scripts/syncPickerStores.ts",
    "picker:sync:dev": "ts-node --transpile-only src/scripts/syncPickerStores.ts --env=development",
    "picker:sync:prod": "ts-node --transpile-only src/scripts/syncPickerStores.ts --env=production",
    "webhooks:register:dev": "ts-node --transpile-only src/scripts/registerPickerWebhooks.ts --env=development",
    "webhooks:register:prod": "ts-node --transpile-only src/scripts/registerPickerWebhooks.ts --env=production",
    "payphone:sync": "ts-node --transpile-only src/scripts/syncPayphoneStores.ts",
    "products:fix-branches": "ts-node --transpile-only src/scripts/fixProductBranches.ts",
    "branches:audit": "ts-node --transpile-only src/scripts/auditBranches.ts",
    "branches:audit:prod": "ts-node --transpile-only src/scripts/auditBranches.ts --env=production",
    "db:clone": "ts-node --transpile-only src/scripts/cloneDatabase.ts",
    "branches:hours": "ts-node --transpile-only src/scripts/setBranchHours.ts",
    "import:product-images": "ts-node src/scripts/importProductImages.ts",
    "start": "node dist/index.js",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.5.0",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "sharp": "^0.35.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
