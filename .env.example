# Entorno lógico: local | tunnel | develop | production
APP_ENV=local
NODE_ENV=development
PORT=8101

# Mongo (dev -> cluster boloncity-dev, prod -> cluster boloncity-prod)
DB_URI=
JWT_SECRET=

# PayPhone
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Boloncity <team@boloncity.com>

# Picker Express
# development -> https://dev-api.pickerexpress.com/api  (usa pickerStore.storeApiKey)
# production  -> https://api.pickerexpress.com/api      (usa pickerStore.productionStoreApiKey)
PICKER_ENV=development
PICKER_API_BASE_URL=https://dev-api.pickerexpress.com/api
PICKER_MASTER_KEY=

GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BOLONCITY_IMAGE_DIR=

# Orígenes CORS extra, separados por coma
EXTRA_CORS_ORIGINS=
SLACK_ERROR_WEBHOOK=
